{
	"name": "eslint-config-wikimedia",
	"version": "0.33.1",
	"description": "ESLint config following Wikimedia code conventions.",
	"main": "flat.js",
	"scripts": {
		"test": "qunit test/test.js && npm run lint",
		"lint": "eslint . --max-warnings 0",
		"changelog": "git log HEAD --format=\"* %s (%aN)\" --no-merges --not --tags | sort",
		"build-invalid": "node test/test.js dump"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wikimedia/eslint-config-wikimedia.git"
	},
	"homepage": "https://www.mediawiki.org/wiki/Manual:Coding_conventions/JavaScript",
	"bugs": "https://github.com/wikimedia/eslint-config-wikimedia/issues",
	"keywords": [
		"style guide",
		"eslint",
		"eslintconfig",
		"wikimedia"
	],
	"engines": {
		"node": ">=22.12 <27"
	},
	"files": [
		"flat.js",
		"common.js",
		"client.js",
		"node.js",
		"jest.js",
		"jquery.js",
		"jsdoc.js",
		"jsduck.js",
		"json.js",
		"mediawiki.js",
		"mocha.js",
		"qunit.js",
		"selenium.js",
		"server.js",
		"typescript.js",
		"yaml.js",
		"client/",
		"language/",
		"lib/",
		"mediawiki/",
		"vue/",
		"vue3/"
	],
	"contributors": [
		"James D. Forrester <jforrester@wikimedia.org>",
		"Ed Sanders <ejsanders@gmail.com>",
		"Timo Tijhof <krinklemail@gmail.com>",
		"Oleg Gaidarenko <markelog@gmail.com>"
	],
	"license": "MIT",
	"peerDependencies": {
		"eslint": "^9.29.0"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "^6.0.1",
		"@typescript-eslint/eslint-plugin": "8.54.0",
		"@typescript-eslint/parser": "8.54.0",
		"browserslist-config-wikimedia": "^0.9.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-es-x": "^9.7.0",
		"eslint-plugin-jest": "^29.12.2",
		"eslint-plugin-jsdoc": "^65.5.3",
		"eslint-plugin-json-es": "^1.6.0",
		"eslint-plugin-mediawiki": "^0.8.4",
		"eslint-plugin-mocha": "^10.5.0",
		"eslint-plugin-n": "^17.24.0",
		"eslint-plugin-no-jquery": "^6.0.2",
		"eslint-plugin-qunit": "^8.2.6",
		"eslint-plugin-security": "^4.0.0",
		"eslint-plugin-unicorn": "^56.0.1",
		"eslint-plugin-vue": "^9.33.0",
		"eslint-plugin-wdio": "9.23.0",
		"eslint-plugin-yml": "^1.19.0",
		"globals": "^17.14.0"
	},
	"devDependencies": {
		"escape-string-regexp": "^4.0.0",
		"fs-readdir-recursive": "^1.1.0",
		"qunit": "^2.26.0"
	}
}
